AIEO_ENVIRONMENT=development
AIEO_LOG_LEVEL=INFO
AIEO_TELEMETRY_ENABLED=true
AIEO_METRICS_ENABLED=true
AIEO_OTEL_SERVICE_NAME=ai-engineering-orchestrator
# Exemplo: http://otel-collector:4318/v1/traces. Sem endpoint, spans ficam locais.
# AIEO_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
AIEO_DEMO_MODE=true
AIEO_MAX_STEPS=12
AIEO_AGENT_TIMEOUT_SECONDS=5
AIEO_MAX_RETRIES=1
AIEO_DATABASE_URL=postgresql+psycopg://aieo:aieo@postgres:5432/aieo
AIEO_LLM_PROVIDER=simulated
AIEO_LLM_MODEL=gpt-6-astra
AIEO_LLM_PLANNING_ENABLED=true
AIEO_MAX_LLM_INPUT_TOKENS=4000
AIEO_MAX_LLM_OUTPUT_TOKENS=1000
AIEO_EMBEDDING_DIMENSIONS=16
AIEO_KNOWLEDGE_CHUNK_SIZE=800
AIEO_KNOWLEDGE_CHUNK_OVERLAP=100
AIEO_MCP_PROJECT_CONFIG_DIR=configs/projects
AIEO_GITHUB_EVIDENCE_TIMEOUT_SECONDS=10
# Defina AIEO_GITHUB_PRIVATE_READ_TOKEN apenas no ambiente ou secret store; nunca faça commit.
AIEO_GITHUB_PRIVATE_READ_REPOSITORY=AriRoberto/app-ams
# Em container, prefira AIEO_GITHUB_PRIVATE_READ_TOKEN_FILE=/run/secrets/github_private_read_token
AIEO_EVIDENCE_MAX_FILES=200
AIEO_EVIDENCE_MAX_FILE_BYTES=1000000
AIEO_EVIDENCE_MAX_TOTAL_BYTES=5000000
AIEO_EVIDENCE_MAX_CONTENT_FILES=8
AIEO_EVIDENCE_MAX_CONTENT_FILE_BYTES=64000
AIEO_EVIDENCE_MAX_CONTENT_TOTAL_BYTES=256000
AIEO_EVIDENCE_CONTEXT_MAX_CHARS=12000
