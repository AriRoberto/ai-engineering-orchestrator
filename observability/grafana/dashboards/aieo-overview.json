  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "id": 1,
      "targets": [{"expr": "sum(rate(aieo_http_server_requests_total[5m]))", "legendFormat": "requisições/s", "refId": "A"}],
      "title": "Taxa de requisições",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
      "id": 2,
      "targets": [{"expr": "sum(rate(aieo_http_server_requests_total{http_response_status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(aieo_http_server_requests_total[5m])), 0.001)", "legendFormat": "erros 5xx", "refId": "A"}],
      "title": "Taxa de erros",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
      "id": 3,
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(aieo_http_server_duration_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "A"}],
      "title": "Latência p95",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 4,
      "targets": [{"expr": "sum by (execution_source, execution_status) (aieo_executions_total)", "legendFormat": "{{execution_source}} / {{execution_status}}", "refId": "A"}],
      "title": "Execuções por origem e estado",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": 0}, {"color": "green", "value": 1}]}}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 5,
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}},
      "targets": [{"expr": "up{job=\"ai-engineering-orchestrator\"}", "legendFormat": "API", "refId": "A"}],
      "title": "Disponibilidade do target",
      "type": "stat"
